function makeLibrary(groups,target){
  target.innerHTML="";
  groups.forEach(([title,tools])=>{
    const cat=document.createElement("section");cat.className="category";
    const h=document.createElement("h3");h.textContent=title;cat.appendChild(h);
    const grid=document.createElement("div");grid.className="grid";
    tools.forEach(([glyph,name,id])=>{
      const b=document.createElement("button");b.className="libraryTool"+(["gradient","pen","shapeBuilder","mesh","symR","kaleido","p3","p2","p1"].includes(id)?" pro":"");
      b.innerHTML=`<span class="glyph">${glyph}</span><small>${name}</small>`;
      b.onclick=()=>activateLibraryTool(id,name);grid.appendChild(b);
    });
    cat.appendChild(grid);target.appendChild(cat);
  });
}
function activateLibraryTool(id,name){
