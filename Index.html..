<script>
(() => {
"use strict";

const canvas=document.getElementById("canvas"),ctx=canvas.getContext("2d");
const stage=document.getElementById("stage"),statusEl=document.getElementById("status");
let state={
  zoom:1, panX:0, panY:0, tool:"pen", color:"#111111", size:6,
  layers:[{id:crypto.randomUUID(),name:"Vector Layer",objects:[]}],
  activeLayer:0, selected:null, history:[], future:[], drawing:null, drag:null
};

const $=id=>document.getElementById(id);
function status(s){statusEl.textContent=s}
function clone(o){return JSON.parse(JSON.stringify(o))}
function snapshot(){return clone({layers:state.layers,activeLayer:state.activeLayer,selected:state.selected})}
function commit(){
  state.history.push(snapshot()); if(state.history.length>80)state.history.shift();
  state.future=[]; renderLayers(); render();
}
function undo(){
  if(!state.history.length)return;
  state.future.push(snapshot()); const s=state.history.pop();
  state.layers=s.layers;state.activeLayer=s.activeLayer;state.selected=s.selected;renderLayers();render();
}
function redo(){
  if(!state.future.length)return;
  state.history.push(snapshot()); const s=state.future.pop();
  state.layers=s.layers;state.activeLayer=s.activeLayer;state.selected=s.selected;renderLayers();render();
}
function activeLayer(){return state.layers[state.activeLayer]}

function fitCanvas(){
  const r=stage.getBoundingClientRect(), pad=70;
  const z=Math.min((r.width-pad)/canvas.width,(r.height-pad)/canvas.height);
  state.zoom=Math.max(.2,Math.min(2,z));state.panX=0;state.panY=0;applyCanvasTransform();
}
function applyCanvasTransform(){
  canvas.style.width=(canvas.width*state.zoom)+"px";canvas.style.height=(canvas.height*state.zoom)+"px";
  canvas.style.transform=`translate(${state.panX}px,${state.panY}px)`;render();
}
function point(e){
  const r=canvas.getBoundingClientRect();
  return {x:(e.clientX-r.left)/state.zoom,y:(e.clientY-r.top)/state.zoom}
}
function roundedPath(c,p){
  c.beginPath();
  if(p.points.length<2){c.arc(p.points[0]?.x||0,p.points[0]?.y||0,p.size/2,0,Math.PI*2);c.fill();return}
  c.moveTo(p.points[0].x,p.points[0].y);
  for(let i=1;i<p.points.length-1;i++){
    const a=p.points[i],b=p.points[i+1];
    c.quadraticCurveTo(a.x,a.y,(a.x+b.x)/2,(a.y+b.y)/2);
  }
  const n=p.points.length;c.quadraticCurveTo(p.points[n-1].x,p.points[n-1].y,p.points[n-1].x,p.points[n-1].y);
}
function drawPathObject(c,o){
  c.save();c.globalAlpha=o.opacity??1;c.lineCap="round";c.lineJoin="round";
  c.strokeStyle=o.stroke||"#111";c.lineWidth=o.width||6;
  if(o.fill){c.fillStyle=o.fill}
  if(o.type==="free"){roundedPath(c,o);c.stroke()}
  else if(o.type==="line"){c.beginPath();c.moveTo(o.x1,o.y1);c.lineTo(o.x2,o.y2);c.stroke()}
  else if(o.type==="rect"){c.beginPath();c.rect(o.x,o.y,o.w,o.h);o.fill?c.fill():c.stroke()}
  else if(o.type==="ellipse"){c.beginPath();c.ellipse(o.cx,o.cy,Math.abs(o.rx),Math.abs(o.ry),0,0,Math.PI*2);o.fill?c.fill():c.stroke()}
  else if(o.type==="path"){
    c.beginPath(); const pts=o.points||[]; if(!pts.length){c.restore();return}
    c.moveTo(pts[0].x,pts[0].y);
    for(let i=1;i<pts.length;i++) c.lineTo(pts[i].x,pts[i].y);
    c.stroke();
  }
  c.restore();
}
function drawGradient(o){
  const gctx=ctx;
  let g;
  if(o.gradient.type==="radial") g=gctx.createRadialGradient(o.gradient.x1,o.gradient.y1,0,o.gradient.x2,o.gradient.y2,o.gradient.r);
  else g=gctx.createLinearGradient(o.gradient.x1,o.gradient.y1,o.gradient.x2,o.gradient.y2);
  g.addColorStop(0,o.gradient.a);g.addColorStop(1,o.gradient.b);
  ctx.save();ctx.fillStyle=g;ctx.strokeStyle=g;ctx.lineWidth=o.width||6;
  if(o.type==="rect"){ctx.fillRect(o.x,o.y,o.w,o.h)}
  else if(o.type==="ellipse"){ctx.beginPath();ctx.ellipse(o.cx,o.cy,Math.abs(o.rx),Math.abs(o.ry),0,0,Math.PI*2);ctx.fill()}
  ctx.restore();
}
function render(){
  ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.fillStyle="#fff";ctx.fillRect(0,0,canvas.width,canvas.height);
  for(const layer of state.layers){
    if(layer.hidden)continue;
    for(const o of layer.objects){
      if(o.type==="image"){ if(o.img){ctx.drawImage(o.img,o.x,o.y,o.w,o.h)} }
      else if(o.gradient)drawGradient(o); else drawPathObject(ctx,o);
      if(o.id===state.selected)drawSelection(o);
    }
  }
}
function drawSelection(o){
  const b=bounds(o);if(!b)return;
  ctx.save();ctx.strokeStyle="#2788ff";ctx.setLineDash([6,4]);ctx.lineWidth=1;ctx.strokeRect(b.x,b.y,b.w,b.h);ctx.setLineDash([]);
  for(const p of [[b.x,b.y],[b.x+b.w,b.y],[b.x,b.y+b.h],[b.x+b.w,b.y+b.h]]){ctx.fillStyle="#fff";ctx.strokeStyle="#2788ff";ctx.beginPath();ctx.rect(p[0]-5,p[1]-5,10,10);ctx.fill();ctx.stroke()}
  ctx.restore();
}
function bounds(o){
  if(o.type==="rect")return {x:Math.min(o.x,o.x+o.w),y:Math.min(o.y,o.y+o.h),w:Math.abs(o.w),h:Math.abs(o.h)};
  if(o.type==="ellipse")return {x:o.cx-o.rx,y:o.cy-o.ry,w:o.rx*2,h:o.ry*2};
  if(o.type==="line")return {x:Math.min(o.x1,o.x2),y:Math.min(o.y1,o.y2),w:Math.abs(o.x2-o.x1),h:Math.abs(o.y2-o.y1)};
  if(o.points?.length){let xs=o.points.map(p=>p.x),ys=o.points.map(p=>p.y);let x=Math.min(...xs),y=Math.min(...ys);return{x,y,w:Math.max(...xs)-x,h:Math.max(...ys)-y}}
  return null;
}
function hitObject(p,o){
  const b=bounds(o);return b && p.x>=b.x-10&&p.x<=b.x+b.w+10&&p.y>=b.y-10&&p.y<=b.y+b.h+10;
}
function renderLayers(){
  const box=$("layersList");box.innerHTML="";
  state.layers.forEach((l,i)=>{
    const d=document.createElement("div");d.className="layer"+(i===state.activeLayer?" active":"");
    d.textContent=(l.hidden?"◌ ":"◉ ")+l.name;d.onclick=()=>{state.activeLayer=i;renderLayers();render()};
    box.appendChild(d);
  });
}
function addLayer(name="Vector Layer"){
  state.layers.push({id:crypto.randomUUID(),name,objects:[]});state.activeLayer=state.layers.length-1;commit();
}
function selectTool(t){
  state.tool=t;document.querySelectorAll(".toolbtn").forEach(b=>b.classList.toggle("active",b.dataset.tool===t));
  status("الأداة: "+toolName(t));
}
function toolName(t){return ({pen:"قلم حر",select:"تحديد",node:"العقد",eraser:"ممحاة",line:"خط",rect:"مستطيل",ellipse:"دائرة",gradient:"Gradient",pan:"تحريك"})[t]||t}

canvas.addEventListener("pointerdown",e=>{
  canvas.setPointerCapture(e.pointerId);const p=point(e);
  if(state.tool==="pan"){state.drag={x:e.clientX,y:e.clientY,px:state.panX,py:state.panY};return}
  if(state.tool==="select"||state.tool==="node"){
    let found=null;for(let i=activeLayer().objects.length-1;i>=0;i--)if(hitObject(p,activeLayer().objects[i])){found=activeLayer().objects[i];break}
    state.selected=found?.id||null;render();return;
  }
  if(state.tool==="gradient"){
    state.drag={start:p,end:p};return;
  }
  if(state.tool==="eraser"){
    const before=activeLayer().objects.length;
    activeLayer().objects=activeLayer().objects.filter(o=>!hitObject(p,o));
    if(activeLayer().objects.length!==before){state.selected=null;commit()}return;
  }
  state.drag={start:p,end:p};
  if(state.tool==="pen")state.drawing={type:"free",points:[p],stroke:state.color,width:+state.size,id:crypto.randomUUID()};
});
canvas.addEventListener("pointermove",e=>{
  if(!state.drag&&!state.drawing)return;const p=point(e);
  if(state.tool==="pan"&&state.drag){state.panX=state.drag.px+(e.clientX-state.drag.x);state.panY=state.drag.py+(e.clientY-state.drag.y);applyCanvasTransform();return}
  if(state.drawing){state.drawing.points.push(p);render();drawPathObject(ctx,state.drawing);return}
  if(state.drag){state.drag.end=p;render();
    if(state.tool==="line"){drawPathObject(ctx,{type:"line",x1:state.drag.start.x,y1:state.drag.start.y,x2:p.x,y2:p.y,stroke:state.color,width:+state.size})}
    if(state.tool==="rect"){drawPathObject(ctx,{type:"rect",x:state.drag.start.x,y:state.drag.start.y,w:p.x-state.drag.start.x,h:p.y-state.drag.start.y,stroke:state.color,width:+state.size})}
    if(state.tool==="ellipse"){drawPathObject(ctx,{type:"ellipse",cx:(state.drag.start.x+p.x)/2,cy:(state.drag.start.y+p.y)/2,rx:Math.abs(p.x-state.drag.start.x)/2,ry:Math.abs(p.y-state.drag.start.y)/2,stroke:state.color,width:+state.size})}
  }
});
canvas.addEventListener("pointerup",e=>{
  if(state.tool==="pan"){state.drag=null;return}
  if(state.drawing){
    if(state.drawing.points.length>1){activeLayer().objects.push(state.drawing);state.selected=state.drawing.id;commit()}
    state.drawing=null;return;
  }
  if(!state.drag)return;
  const s=state.drag.start,p=state.drag.end;state.drag=null;
  if(state.tool==="gradient"){openGradient();return}
  if(state.tool==="line")activeLayer().objects.push({type:"line",id:crypto.randomUUID(),x1:s.x,y1:s.y,x2:p.x,y2:p.y,stroke:state.color,width:+state.size});
  if(state.tool==="rect")activeLayer().objects.push({type:"rect",id:crypto.randomUUID(),x:s.x,y:s.y,w:p.x-s.x,h:p.y-s.y,stroke:state.color,width:+state.size});
  if(state.tool==="ellipse")activeLayer().objects.push({type:"ellipse",id:crypto.randomUUID(),cx:(s.x+p.x)/2,cy:(s.y+p.y)/2,rx:Math.abs(p.x-s.x)/2,ry:Math.abs(p.y-s.y)/2,stroke:state.color,width:+state.size});
  if(["line","rect","ellipse"].includes(state.tool)){state.selected=activeLayer().objects.at(-1).id;commit()}
});

$("color").oninput=e=>{state.color=e.target.value};
$("size").oninput=e=>{state.size=+e.target.value};
$("undoBtn").onclick=undo;$("redoBtn").onclick=redo;$("fitBtn").onclick=fitCanvas;
$("layersBtn").onclick=()=>$("layerPanel").classList.toggle("open");
$("addLayer").onclick=()=>addLayer();
$("libraryBtn").onclick=()=>{$("libraryPanel").classList.add("open")};
$("closeLibrary").onclick=()=>$("libraryPanel").classList.remove("open");
$("homeBtn").onclick=()=>{if(confirm("إنشاء مشروع جديد؟")){state.layers=[{id:crypto.randomUUID(),name:"Vector Layer",objects:[]}];state.activeLayer=0;state.selected=null;state.history=[];state.future=[];renderLayers();render();status("مشروع جديد")}};
document.querySelectorAll(".toolbtn").forEach(b=>b.onclick=()=>selectTool(b.dataset.tool));

function openGradient(){$("gradientModal").classList.add("open")}
$("cancelGrad").onclick=()=>$("gradientModal").classList.remove("open");
$("applyGrad").onclick=()=>{
  const s=state.drag?.start||{x:200,y:200},p=state.drag?.end||{x:700,y:500};
  const g={type:$("gradType").value,a:$("gradA").value,b:$("gradB").value,x1:s.x,y1:s.y,x2:p.x,y2:p.y,r:Math.hypot(p.x-s.x,p.y-s.y)};
  let o=state.selected?activeLayer().objects.find(x=>x.id===state.selected):null;
  if(!o)o={type:"rect",id:crypto.randomUUID(),x:120,y:120,w:500,h:300,stroke:"#111",width:2};
  if(o.type!=="rect"&&o.type!=="ellipse"){o={type:"rect",id:crypto.randomUUID(),x:120,y:120,w:500,h:300,stroke:"#111",width:2};activeLayer().objects.push(o)}
  o.gradient=g;state.selected=o.id;$("gradientModal").classList.remove("open");commit();state.drag=null;
};
document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{
  document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===t));
  $("createTools").style.display=t.dataset.tab==="create"?"block":"none";
  $("editTools").style.display=t.dataset.tab==="edit"?"block":"none";
});

const createGroups=[
["التعبئة",[
